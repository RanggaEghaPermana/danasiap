{
  "expo": {
    "name": "DanaSiap",
    "slug": "danasiap",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "danasiap",
    "android": {
      "package": "id.danasiap.app",
      "versionCode": 1,
      "permissions": ["POST_NOTIFICATIONS"],
      "allowBackup": false,
      "adaptiveIcon": {"foregroundImage": "./assets/icon.png", "backgroundColor": "#C8ED69"}
    },
    "plugins": ["expo-font", "expo-sqlite", "expo-secure-store", ["expo-notifications", {"color": "#C3EA5B"}], ["expo-image-picker", {"photosPermission": "Izinkan DanaSiap mengakses galeri foto untuk foto profil."}], "./plugins/withReleaseSigning.cjs"],
    "extra": {"privacy": "Data tersimpan di perangkat. Sinkron cloud hanya aktif setelah dikonfigurasi."}
  }
}
